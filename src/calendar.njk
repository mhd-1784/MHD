---
layout: base.njk
title: Calendar
permalink: /calendar/
---

<section class="page-hero">
    <div class="container">
        <h1>Calendar</h1>
        <p>Upcoming trips, events, and regular sessions</p>
    </div>
</section>

<section class="form-section">
    <div class="container" style="max-width:900px;">
        <div class="calendar-info-grid">
            <div class="calendar-info-card">
                <div class="calendar-info-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                </div>
                <h2>Regular Sessions</h2>
                <p>Our Club Night is every <strong>Wednesday</strong>, starting at 8pm with a quick briefing to catch-up on recent and upcoming diving and news.</p>
                <p>This is followed by our <strong>pool training session</strong> and cylinder refilling at Hatfield Swim Centre, 9–10pm.</p>
            </div>

            <div class="calendar-info-card">
                <div class="calendar-info-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15h6"/></svg>
                </div>
                <h2>Year Planner</h2>
                <p>Download our full year planner to see all upcoming trips and events at a glance.</p>
                <a href="/images/year-planner-2026.pdf" class="btn-primary" target="_blank" rel="noopener">Download Year Planner (PDF)</a>
            </div>
        </div>

        <div style="margin-top:56px;">
            <h2 style="font-family:'Montserrat',sans-serif; font-size:1.8rem; color:var(--dark); margin-bottom:32px;">Upcoming Trips &amp; Events</h2>
            
            <div class="events-list">
                {% for event in collections.events %}
                <div class="event-card" data-end-date="{{ event.data.endDate or event.data.startDate }}">
                    <div class="event-date">
                        <span class="event-day">{{ event.data.startDate | dateFormat }}</span>
                        {% if event.data.endDate and event.data.endDate != event.data.startDate %}
                        <span class="event-range">to {{ event.data.endDate | dateFormat }}</span>
                        {% endif %}
                    </div>
                    <div class="event-details">
                        <h3>{{ event.data.title }}</h3>
                        <p>{{ event.data.description }}</p>
                        <div class="event-meta">
                            {% if event.data.qualification %}
                            <span class="event-tag">{{ event.data.qualification }}</span>
                            {% endif %}
                            {% if event.data.spaces %}
                            <span class="event-tag event-tag--available">Spaces available</span>
                            {% else %}
                            <span class="event-tag event-tag--full">Full (taking reserves)</span>
                            {% endif %}
                            {% if event.data.contact %}
                            <span class="event-contact">Contact: {{ event.data.contact }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
